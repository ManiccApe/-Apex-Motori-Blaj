<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="9dp" android:orientation="vertical" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="A.M.B. · Notizie" android:textSize="14sp"
            android:textColor="#1A2530" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="37dp" android:layout_height="32dp"
            android:gravity="center" android:text="↻" android:textSize="23sp" android:textColor="#303E4D"
            android:contentDescription="Aggiorna" />
        <TextView android:id="@+id/widget_settings" android:layout_width="35dp" android:layout_height="32dp"
            android:gravity="center" android:text="⚙" android:textSize="18sp" android:textColor="#303E4D"
            android:contentDescription="Impostazioni widget" />
    </LinearLayout>
    <ListView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:dividerHeight="3dp" android:divider="@android:color/transparent"
        android:scrollbars="vertical" android:cacheColorHint="@android:color/transparent" />
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="Apri A.M.B. e aggiorna le fonti per vedere le notizie"
        android:textSize="12sp" android:padding="12dp" android:textColor="#657686"/>
</LinearLayout>
