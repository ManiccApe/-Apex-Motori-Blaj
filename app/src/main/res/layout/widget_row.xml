<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="70dp"
    android:background="@drawable/widget_row_bg" android:orientation="horizontal"
    android:padding="5dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_image" android:layout_width="61dp" android:layout_height="57dp"
        android:scaleType="centerCrop" android:contentDescription="Foto notizia" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp">
        <TextView android:id="@+id/widget_category" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:textStyle="bold" android:textSize="10sp"
            android:textColor="#A5473D" />
        <TextView android:id="@+id/widget_headline" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end" android:textStyle="bold" android:textSize="12sp"
            android:textColor="#1E2732" />
        <TextView android:id="@+id/widget_source" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:textSize="9sp" android:textColor="#647487" />
    </LinearLayout>
</LinearLayout>
